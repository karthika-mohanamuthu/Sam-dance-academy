@{
    ViewData["Title"] = "Dance Styles";
}

<section id="dance-styles" class="container py-5">
    <h2 class="text-center mb-4">Our Dance Styles</h2>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <img src="~/images/classical.jpg"
                         class="dance-card-img"
                         alt="Classical Dance" />
                    <h3 class="card-title">Classical Dance</h3>
                    <p class="card-text">
                        Learn traditional movements, rhythm and expressions.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <img src="~/images/western.jpg"
                         class="dance-card-img"
                         alt="Western Dance" />
                    <h3 class="card-title">Western Dance</h3>
                    <p class="card-text">
                        Enjoy energetic movements and modern choreography.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <img src="~/images/kids.jpg"
                         class="dance-card-img"
                         alt="Kids Dance" />
                    <h3 class="card-title">Kids Dance</h3>
                    <p class="card-text">
                        Help young dancers build confidence and creativity.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <img src="~/images/folk.png"
                         class="dance-card-img"
                         alt="Folk Dance" />
                    <h3 class="card-title">Folk Dance</h3>
                    <p class="card-text">
                        Celebrate our culture through traditional folk
                        movements and energetic performances.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <img src="~/images/hiphop.jpg"
                         class="dance-card-img"
                         alt="Hip-Hop Dance" />
                    <h3 class="card-title">Hip-Hop</h3>
                    <p class="card-text">
                        Learn urban dance moves, freestyle techniques
                        and modern choreography.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <img src="~/images/zumba.jpg"
                         class="dance-card-img"
                         alt="Zumba Dance" />
                    <h3 class="card-title">Zumba</h3>
                    <p class="card-text">
                        Stay active with fun, energetic dance fitness routines.
                    </p>
                </div>
            </div>
        </div>

    </div>
</section>
