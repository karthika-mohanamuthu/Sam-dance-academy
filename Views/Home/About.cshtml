@{
    ViewData["Title"] = "About Us";
}

<section id="about-us" class="about-section">
    <div class="container">
        <div class="row align-items-center g-4">

            <div class="col-md-6">
                <h2>About Our Academy</h2>

                <p>
                    We believe dance is more than movement.
                    It is a way to express emotions, build confidence,
                    and celebrate our culture.
                </p>

                <p>
                    From traditional Indian dance to modern styles,
                    we welcome dancers of all ages and skill levels.
                </p>

                <a asp-controller="Home"
                   asp-action="Contact"
                   class="btn btn-primary">
                    Join Our Academy
                </a>
            </div>

            <div class="col-md-6">
                <div class="about-highlight">
                    <h3>Move With Passion</h3>
                    <p>Learn. Practice. Perform. Grow.</p>

                    <div class="about-stats">
                        <div>
                            <h4>All Ages</h4>
                            <p>Everyone is welcome</p>
                        </div>

                        <div>
                            <h4>Many Styles</h4>
                            <p>Find your rhythm</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
