@model IEnumerable<DanceAcademy.Models.EnquiryListViewModel>

@{
    ViewData["Title"] = "Enquiries";
}

<div class="container py-4">
    <h2>Dance Academy Enquiries</h2>
    <p>View all submitted student enquiries.</p>

    @if (!Model.Any())
    {
        <p>No enquiries found.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Dance Style</th>
                        <th>Message</th>
                        <th>Submitted At</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var enquiry in Model)
                    {
                        <tr>
                            <td>@enquiry.FullName</td>
                            <td>@enquiry.PhoneNumber</td>
                            <td>@enquiry.Email</td>
                            <td>@enquiry.DanceStyle</td>
                            <td>@enquiry.Message</td>
                            <td>@(enquiry.SubmittedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "Not available")</td>
                            <td>
                                <form asp-controller="Home" asp-action="UpdateEnquiryStatus" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@enquiry.Id" />

                                    <select name="status" class="form-select" onchange="this.form.submit()">
                                        <option value="New" selected="@(enquiry.Status == "New")">New</option>
                                        <option value="Contacted" selected="@(enquiry.Status == "Contacted")">Contacted</option>
                                        <option value="Enrolled" selected="@(enquiry.Status == "Enrolled")">Enrolled</option>
                                    </select>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
